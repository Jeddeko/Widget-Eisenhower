<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_widget"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_widget"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/QuickAddTheme" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <receiver
            android:name=".EisenhowerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.arena.eisenhower.ACTION_TOGGLE" />
                <action android:name="com.arena.eisenhower.ACTION_REFRESH" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eisenhower_widget_info" />
        </receiver>

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.arena.eisenhower.ACTION_NOTIFY_ADD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
