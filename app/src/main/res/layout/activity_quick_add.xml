<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/quickTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Captura rápida"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btnDeleteTask"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:visibility="gone" />
        </RelativeLayout>

        <EditText
            android:id="@+id/quickInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="¿Qué hay que hacer?"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp" />

        <!-- SELECTOR DE CUADRANTE BASE (Se oculta si es evento) -->
        <LinearLayout
            android:id="@+id/layoutBaseQuadrant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cuadrante (Tarea normal)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
            <Spinner
                android:id="@+id/quickQuadrant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- FECHA PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha de vencimiento / Inicio del Evento"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickDateBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sin fecha" />

        <!-- RECURRENCIA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Repetición"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerRecurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- CHECKBOX EVENTO -->
        <CheckBox
            android:id="@+id/checkIsEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:text="Es un evento. Ocultar en la matriz hasta que falten X días." />

        <!-- OPCIONES DE EVENTO (3 FASES CON BOTÓN DE CALENDARIO) -->
        <LinearLayout
            android:id="@+id/layoutEventOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/card_background"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <!-- FASE 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FASE 1: Planificación Lejana"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <EditText android:id="@+id/etDaysPhase1" android:layout_width="70dp" android:layout_height="wrap_content" android:inputType="number" android:text="30" android:hint="Días"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="días antes" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <ImageButton android:id="@+id/btnCalPhase1" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_my_calendar" android:background="?attr/selectableItemBackgroundBorderless"/>
                <Spinner android:id="@+id/spinnerPhase1Quadrant" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- FASE 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FASE 2: Aproximación"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <EditText android:id="@+id/etDaysPhase2" android:layout_width="70dp" android:layout_height="wrap_content" android:inputType="number" android:text="7" android:hint="Días"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="días antes" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <ImageButton android:id="@+id/btnCalPhase2" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_my_calendar" android:background="?attr/selectableItemBackgroundBorderless"/>
                <Spinner android:id="@+id/spinnerPhase2Quadrant" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- FASE 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FASE 3: Día del Evento o Urgencia"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <EditText android:id="@+id/etDaysPhase3" android:layout_width="70dp" android:layout_height="wrap_content" android:inputType="number" android:text="0" android:hint="Días"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="días antes" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
                <ImageButton android:id="@+id/btnCalPhase3" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_my_calendar" android:background="?attr/selectableItemBackgroundBorderless"/>
                <Spinner android:id="@+id/spinnerPhase3Quadrant" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ALERTAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Alertas / Recordatorios"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddReminder"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ Añadir Alerta" />

        <LinearLayout
            android:id="@+id/containerReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <CheckBox
            android:id="@+id/quickCalendarCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:textColor="@color/text_primary"
            android:text="Sincronizar con Calendario" />

        <Button
            android:id="@+id/quickSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GUARDAR" />
    </LinearLayout>
</ScrollView>
